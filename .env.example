# .env.example — plantilla: copia a .env y rellena. NUNCA comitees el .env real.

# Clave de encriptación Fernet (ISO 27001).
# Genérala con:  python -c "from kit_iso.seguridad import ToolkitSeguridad; print(ToolkitSeguridad.generar_clave().decode())"
# Si la pierdes, los datos encriptados son irrecuperables. Si se expone, rótala.
KIT_ISO_CLAVE=

# Base de datos
DB_TIPO=postgres        # "postgres" o "mysql"
DB_HOST=localhost
DB_USUARIO=
DB_PASSWORD=
DB_NOMBRE=
